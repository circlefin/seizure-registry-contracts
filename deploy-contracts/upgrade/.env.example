# SeizureRegistry upgrade environment variables.
# Copy this file to .env and fill in all values before running an upgrade script.
#
#   cp .env.example .env
#   source .env
#
# See README.md for full usage instructions.

# Transaction broadcaster for the upgrade must be the current proxy owner.
OWNER_ADDRESS=

# The deployed SeizureRegistry proxy address to upgrade.
SR_PROXY_ADDRESS=

# The current implementation address behind the proxy (pre-upgrade).
# Used to assert the proxy is in the expected state before broadcasting.
# Prevents double-execution and catches wrong-proxy/wrong-network mistakes.
SR_OLD_IMPL_ADDRESS=

# The newly deployed SeizureRegistry implementation address to upgrade to.
SR_NEW_IMPL_ADDRESS=

# Reinitializer upgrade scripts define additional env vars for their typed parameters.
# See REINITIALIZER_TEMPLATE.sol and README.md for the pattern.
