# Environment Configuration
# Set to LOCAL, TESTNET_STAGING, TESTNET_PROD, or MAINNET_PROD
ENV=LOCAL

# ========== Network Configuration ===============
# RPC URL for the selected environment
RPC_URL=

# ========== SeizureRegistry Deployment ==========
# Deployer address that broadcasts transactions; becomes initial proxy owner
DEPLOYER_ADDRESS=
# USDC (FiatToken) proxy address on this chain
TOKEN_CONTRACT_ADDRESS=

# Designated owner address for the SeizureRegistry contract
SR_OWNER_ADDRESS=

# Actual Roles
SR_SECONDARY_MARKET_BURNER_ADDRESS=
SR_HASH_UPDATER_ADDRESS=
SR_RESCUER_ADDRESS=
SR_ADDRESS_MANAGER_ADDRESS=

# ========== SeizureRegistry Bytecode Verification ==========
# SeizureRegistry implementation address
SR_IMPL_ADDRESS=
# UpgradeablePlaceholder address
SR_UPGRADEABLE_PLACEHOLDER_IMPL_ADDRESS=
# SeizureRegistry proxy address
SR_PROXY_ADDRESS=

# ========== SeizureRegistry State Validation ==========
# Set to "true" after AcceptOwnership has been run to switch ownership assertions:
#   false (default): owner == DEPLOYER_ADDRESS, pendingOwner == SR_OWNER_ADDRESS
#   true:            owner == SR_OWNER_ADDRESS,  pendingOwner == 0x0
SR_OWNERSHIP_TRANSFER_COMPLETED=false
